{
  "id": "maxbotadmn000001",
  "name": "MAX bot — админка контента",
  "nodes": [
    {
      "parameters": {
        "content": "## Админка контента — без кода\n\nДве формы n8n за Basic Auth (логин/пароль — `ADMIN_FORM_USER` / `ADMIN_FORM_PASSWORD` в .env):\n\n- **/form/maxbot-screens** — экран: ключ, текст, кнопки JSON\n- **/form/maxbot-products** — товар каталога\n\nЗапись идёт прямо в `bot_screens` / `bot_products`, бот подхватывает при следующем сообщении. Существующий ключ — перезаписывается.\n\nПлейсхолдеры в тексте и кнопках: `{name}` `{user_id}` `{chat_id}` `{title}` `{short}` `{description}` `{price}` `{id}` `{qty}` `{total}` `{phone}` `{order_id}` `{client}` `{lat}` `{lon}` `{echo}` `{rates_date}` `{rates_lines}` `{orders}`.\n\nНовый экран показывается по кнопке с `payload`, равным его ключу.",
        "width": 720,
        "height": 360,
        "color": 5
      },
      "id": "note--260--340",
      "name": "Sticky Note -260--340",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -340
      ]
    },
    {
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "Экран бота",
        "formDescription": "Ключ экрана — это payload кнопки, которая его открывает. Кнопки — JSON: [[{\"type\":\"callback\",\"text\":\"⬅️ Назад\",\"payload\":\"main\"}]]",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Ключ",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "например delivery"
            },
            {
              "fieldLabel": "Текст",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Markdown MAX: *жирный*, _курсив_. Плейсхолдеры: {name}, {title}…"
            },
            {
              "fieldLabel": "Кнопки",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "[[{\"type\":\"callback\",\"text\":\"⬅️ В меню\",\"payload\":\"main\"}]]"
            }
          ]
        },
        "options": {
          "buttonLabel": "Сохранить",
          "appendAttribution": false
        }
      },
      "id": "Форма: экран",
      "name": "Форма: экран",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -260,
        80
      ],
      "webhookId": "maxbot-screens",
      "credentials": {
        "httpBasicAuth": {
          "id": "maxbotform000001",
          "name": "maxbot-form-admin"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO bot_screens (key, text, buttons, updated_at)\nVALUES ($1, $2, COALESCE(NULLIF($3, ''), '[]')::jsonb, now())\nON CONFLICT (key) DO UPDATE\n   SET text = EXCLUDED.text, buttons = EXCLUDED.buttons, updated_at = now()\nRETURNING key;",
        "options": {
          "queryReplacement": "={{ [$json['Ключ'].trim(), $json['Текст'], ($json['Кнопки'] ?? '').trim()] }}"
        }
      },
      "id": "Сохранить экран",
      "name": "Сохранить экран",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        20,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "maxbotpg000000001",
          "name": "maxbot-postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Сохранено",
        "completionMessage": "={{ 'Экран «' + $json.key + '» записан. Бот покажет его при следующем сообщении.' }}",
        "options": {}
      },
      "id": "Экран сохранён",
      "name": "Экран сохранён",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        300,
