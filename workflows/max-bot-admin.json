    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO bot_products (id, title, price_rub, short, description, sort, active, updated_at)\nVALUES ($1, $2, $3::int, $4, $5, COALESCE(NULLIF($6, '')::int, 100), $7 = 'да', now())\nON CONFLICT (id) DO UPDATE\n   SET title = EXCLUDED.title, price_rub = EXCLUDED.price_rub, short = EXCLUDED.short,\n       description = EXCLUDED.description, sort = EXCLUDED.sort, active = EXCLUDED.active,\n       updated_at = now()\nRETURNING id, title;",
        "options": {
          "queryReplacement": "={{ [$json['id'].trim(), $json['Название'], $json['Цена, ₽'], $json['Коротко'] ?? '', $json['Описание'] ?? '', String($json['Порядок'] ?? ''), $json['В каталоге']] }}"
        }
      },
