      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO bot_users (user_id, chat_id, name, username, events_count)\nVALUES ($1, $2, $3, $4, 1)\nON CONFLICT (user_id) DO UPDATE\n   SET chat_id      = COALESCE(EXCLUDED.chat_id, bot_users.chat_id),\n       name         = EXCLUDED.name,\n       username     = COALESCE(EXCLUDED.username, bot_users.username),\n       last_seen    = now(),\n       events_count = bot_users.events_count + 1\nRETURNING user_id;",
        "options": {
          "queryReplacement": "={{ [$('Событие от источника').item.json.user_id, $('Событие от источника').item.json.chat_id, $('Событие от источника').item.json.name, $('Событие от источника').item.json.username] }}"
        }
