# ============================================================
# Пример конфигурации. Скопируй в .env и заполни значениями.
# .env в репозиторий НЕ коммитится (см. .gitignore).
# ============================================================

# --- MAX API ---
# Базовый URL Bot API MAX. platform-api2.max.ru — домен, на который платформа
# перешла 19 июля 2026; он же используется в banword-max-bot и culture-max-bot.
# Его сертификат подписан Минцифры РФ, поэтому обязателен MAX_CA_BUNDLE ниже.
# Публичный botapi.max.ru отдаёт тот же API с общедоверенным сертификатом и
# работает без CA-bundle — годится для локальной разработки.
MAX_API_BASE_URL=https://platform-api2.max.ru

# Путь к PEM/CRT корневого сертификата Минцифры РФ ВНУТРИ контейнера.
# Файл кладётся в certs/ на хосте, каталог монтируется в /certs только на чтение.
# Значение уходит в NODE_EXTRA_CA_CERTS, поэтому Node добавляет его к системным
# сертификатам, а не заменяет их. Пусто — только системные сертификаты
# (тогда MAX_API_BASE_URL должен указывать на botapi.max.ru).
# Как получить файл: certs/README.md или https://www.gosuslugi.ru/crt
MAX_CA_BUNDLE=/certs/russian-trusted-root-ca.pem

# Токен бота MAX. Получить у @MasterBot в MAX: /newbot -> /token
MAX_BOT_TOKEN=токен_MAX

# Ретраи при 429/5xx от MAX API.
MAX_API_RETRY_ATTEMPTS=3
MAX_API_RETRY_MAX_DELAY=5

# --- Bot ---
# Режим приёма апдейтов: polling (локально) или webhook (прод).
# От него зависит, какой сценарий активируется: make activate смотрит сюда.
BOT_MODE=polling

# Интервал опроса MAX в режиме polling, секунды.
POLL_INTERVAL_SECONDS=10

# Публичный URL n8n без пути; обязателен при BOT_MODE=webhook.
WEBHOOK_HOST=https://домен_бота
# Путь вебхука в n8n. Полный адрес для подписки: $WEBHOOK_HOST/webhook$WEBHOOK_PATH
WEBHOOK_PATH=/max-updates
# Секрет заголовка X-Max-Bot-Api-Secret. ОБЯЗАТЕЛЕН при BOT_MODE=webhook,
# иначе вебхук принимает любые запросы. Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=

# Обрабатывать только личные диалоги (true) или ещё и групповые чаты (false).
# ВНИМАНИЕ: false выпускает бота в групповые чаты, где он состоит.
ONLY_DIALOGS=true

# Уровень логирования: debug/info/warn/error.
LOG_LEVEL=info

# Список user_id администраторов через запятую. Пусто — админ-команд нет.
ADMIN_IDS=

# --- n8n ---
# Порт веб-интерфейса n8n на хосте.
N8N_PORT=5678
N8N_HOST=localhost
# Внешний базовый URL n8n. В проде совпадает с WEBHOOK_HOST.
N8N_WEBHOOK_URL=http://localhost:5678/

# КЛЮЧ ШИФРОВАНИЯ УЧЁТНЫХ ДАННЫХ n8n. Задать ОДИН РАЗ и не менять:
# при смене все сохранённые credentials перестанут расшифровываться.
# Сгенерировать: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Режим выполнения: regular (один процесс) или queue (main + worker + redis).
# В docker-compose.prod.yml зафиксирован queue, в local — regular.
EXECUTIONS_MODE=regular
# Сколько задач тянет один worker одновременно.
N8N_CONCURRENCY=10
# Хранение истории выполнений.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE=true

# Часовой пояс контейнеров и расписаний.
TZ=Europe/Moscow

# --- DB (подключение приложений) ---
DB_HOST=db
DB_PORT=5432
DB_USER=maxn8n
DB_PASSWORD=замените-на-длинный-случайный-пароль
# База самого n8n (сценарии, credentials, история выполнений).
DB_NAME=n8n
# База данных бота (marker, пользователи, журнал событий, состояние диалога).
APP_DB_NAME=maxbot
# Пул соединений n8n к Postgres. Держать в пределах max_connections (по умолчанию 100)
# с учётом worker-ов: main + N*worker + миграции.
DB_POSTGRESDB_POOL_SIZE=10

# --- DB (для контейнера postgres) ---
POSTGRES_USER=maxn8n
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль
POSTGRES_DB=n8n

# --- Redis (только при EXECUTIONS_MODE=queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Сколько worker-контейнеров поднимать в проде.
N8N_WORKER_REPLICAS=1

# --- Источники образов ---
# Дефолты — публичные реестры. В закрытом контуре переопределяются на Harbor:
#   POSTGRES_IMAGE=harbor.volganet.ru/dockerhub-proxy/postgres:17-alpine
#   REDIS_IMAGE=harbor.volganet.ru/dockerhub-proxy/redis:7-alpine
#   N8N_IMAGE=harbor.volganet.ru/dockerhub-proxy/n8nio/n8n:2.37.10
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.37.10
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
