# Токен бота MAX. Получить у @MasterBot в MAX -> /newbot -> /token
MAX_BOT_TOKEN=

# База Bot API MAX
MAX_API_URL=https://botapi.max.ru

# Порт веб-интерфейса n8n на хосте
N8N_PORT=5678

# Хост и внешний URL n8n. Менять только при работе через туннель или домен,
# когда MAX должен достучаться до вебхука снаружи.
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

TZ=Europe/Moscow
